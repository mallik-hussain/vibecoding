# IPL Top Trumps - Environment Configuration

# Cricket API Configuration
CRICKET_API_KEY=your_cricket_api_key_here

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Database (optional for future use)
DATABASE_URL=mongodb://localhost:27017/ipl-top-trumps

# QR Code Generation
QR_CODE_SIZE=300

# Game Configuration
GAME_TIMEOUT=600000
MAX_PLAYERS_PER_GAME=2
